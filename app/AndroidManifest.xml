<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="de.v4aswitch"
    android:versionCode="2"
    android:versionName="1.1.0">

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="33" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_fx_music"
        android:label="V4A Switch">

        <!-- Nur intern erreichbar (Widget-Tasten); fremde Apps koennen keine Root-Befehle ausloesen -->
        <receiver
            android:name=".SwitchReceiver"
            android:exported="false" />

        <!-- Widget: 4 Tasten (FX Music, FX Voice, XHiFi Music, XHiFi Voice) -->
        <receiver
            android:name=".ProfileWidget"
            android:exported="true"
            android:label="V4A Profile (FX + XHiFi)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/profile_widget" />
        </receiver>

        <!-- Vier Starter-Symbole fuer App-Liste / Startbildschirm; ohne Oberflaeche -->
        <activity
            android:name=".FxMusicActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:icon="@drawable/ic_fx_music"
            android:label="FX Music"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".FxVoiceActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:icon="@drawable/ic_fx_voice"
            android:label="FX Voice"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".XhifiMusicActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:icon="@drawable/ic_xhifi_music"
            android:label="XHiFi Music"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".XhifiVoiceActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:icon="@drawable/ic_xhifi_voice"
            android:label="XHiFi Voice"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
